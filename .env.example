# Analityka PostHog (client-side, statyczny eksport)
# Klucz projektu jest kluczem publicznym (i tak widoczny w przeglądarce),
# ale trzymamy go w env, nie w kodzie.
#
# Lokalnie: skopiuj ten plik do .env.local i uzupełnij wartości.
# Vercel:   ustaw te zmienne w Settings → Environment Variables.
# GitHub Pages: ustaw NEXT_PUBLIC_POSTHOG_KEY jako repo secret
#               (Settings → Secrets and variables → Actions).

NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Tylko dla GitHub Pages (Vercel zostawia puste — strona działa w korzeniu).
# Workflow deploy.yml ustawia to automatycznie; nie ruszaj lokalnie.
# NEXT_PUBLIC_BASE_PATH=/fashion-hero-shop
